# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# The Gradle wrapper jar must be committed
!gradle/wrapper/gradle-wrapper.jar

# Gradle / build output
.gradle/
build/
local.properties

# iOS project is generated by XcodeGen from iosApp/project.yml
iosApp/*.xcodeproj
iosApp/iosApp/Info.plist
iosApp/build/
node_modules/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Signing material
*.jks
*.keystore